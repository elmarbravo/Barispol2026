{
  "appId": "com.barispol.workspace",
  "appName": "Barispol",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "url": "https://barispol.com/workspace.html",
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "barispol.com",
      "*.barispol.com",
      "*.supabase.co"
    ],
    "errorPath": "sem-ligacao.html"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    }
  }
}
