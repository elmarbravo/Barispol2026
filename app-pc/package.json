{
  "name": "barispol-pc",
  "version": "1.0.0",
  "private": true,
  "description": "Barispol Workspace para computador (Windows e Mac)",
  "author": "Clínica Barispol, Lda.",
  "repository": "github:elmarbravo/Barispol2026",
  "main": "main.js",
  "scripts": {
    "iniciar": "electron .",
    "windows": "electron-builder --win nsis portable",
    "mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.barispol.workspace",
    "productName": "Barispol",
    "copyright": "Clínica Barispol, Lda.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "sem-ligacao.html",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Barispol Workspace",
      "artifactName": "Barispol-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Barispol-${version}-portatil.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "identity": null
    },
    "dmg": {
      "artifactName": "Barispol-${version}.${ext}"
    }
  }
}
